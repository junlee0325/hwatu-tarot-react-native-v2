{
  "expo": {
    "name": "hwatu-tarot-v2",
    "slug": "hwatu-tarot-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "scheme": "hwatutarotv2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/icon2.png",
      "adaptiveIcon": {
        "backgroundColor": "#1b3320"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.junlee0325.hwatutarotv2",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/blackdot.png", 
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70cc5093-74ac-4da7-9dd8-e6b8c3c40f86"
      }
    }
  }
}