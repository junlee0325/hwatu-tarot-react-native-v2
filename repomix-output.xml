              // marginTop: 3
            }}
          >
            {box.length > 0 &&
              box.map((card, i) => {
                const hasFour = monthCounts[card.month] === 4;
                return (
                  <View
                    style={{
                      width: vw * 0.08,
                      aspectRatio: 230 / 360,
