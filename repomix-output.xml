        >
          <Pressable
            style={{
              display: "flex",
              justifyContent: "center",
              alignItems: "center",
              width: "100%",
            }}
            onPress={() => handleClose()}
            onPressIn={() => {
              Haptics.selectionAsync();
              setTranslateClose(2);
            }}
            onPressOut={() => setTranslateClose(0)}
          >
            <Animated.View
              style={{
                display: "flex",
