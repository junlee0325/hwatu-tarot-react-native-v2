import { useAudio } from "@/context/AudioContext";
import { useLanguage } from "@/context/LanguageContext";
import {
  Jua_400Regular,
  useFonts as useJuaFonts,
} from "@expo-google-fonts/jua";
import * as Haptics from "expo-haptics";
import {
  Dimensions,
  Image,
  Pressable,
  StyleSheet,
  Text,
  View,
} from "react-native";

interface Card {
  month: string;
  rank: string;
  id: string;
  img: string;
  rotation: number;
  title: { en: string; ko: string };
  meaning: { en: string; ko: string };
}

interface Prop {
  fourCards: Card[];
  updateFourCards: (value: Card[]) => void;
  imageSet: Record<string, any>;
  first: Card | null;
  setFirst: (value: Card | null) => void;
  second: Card | null;
  setSecond: (value: Card | null) => void;
  showLabels: Boolean;
}

const FourStack = ({
  fourCards,
  imageSet,
  first,
  setFirst,
  second,
  setSecond,
  showLabels,
}: Prop) => {
  const { lang } = useLanguage();
  const { playPlastic } = useAudio();

  const [juaLoaded] = useJuaFonts({ Jua_400Regular });

  const { width: vw } = Dimensions.get("window");

  const handlePress = (card: Card) => {
    if (first === null) {
      setFirst(card);
      playPlastic();
      console.log("first card selected");
      return;
    }

    if (card === first) {
      setFirst(null);
      setSecond(null);
      console.log("same card");
      return;
    }

    if (second === null) {
      setSecond(card);
      console.log("initial match");
    }
  };

  return (
    <View
      style={{
        width: "20%",
        flexDirection: "column",
        alignItems: "center",
        position: "relative",
      }}
    >
      {fourCards.map((x, i) => {
        const isTop = x === fourCards[fourCards.length - 1];
        const isSelected = first === x;

        return (
          <Pressable
            key={i}
            style={{
              ...styles.imageBox,
              width: vw * 0.15,
              top: vw * 0.15 * (360 / 230) * 0.25 * i,
              borderWidth: isSelected ? 2 : 1,
              borderBottomWidth: 2,
              borderRightWidth: 2,
              borderColor: isSelected
                ? "rgba(255, 217, 0, 1)"
                : "rgba(0,0,0,0.5)",
              transform: isTop
                ? [
                    { rotate: `${x.rotation}deg` },
                    { scale: isSelected ? 1.15 : 1 },
                  ]
                : [{ rotate: `${x.rotation * -1}deg` }],
              // boxShadow: isSelected
              //   ? "0px 0px 0px 2px rgba(255, 217, 0, 1)"
              //   : isTop
              //     ? "2px 2px 2px black"
              //     : "1px 1px 2px black",
              elevation: 0,
              shadowColor: "#000000",
              zIndex: isSelected ? 10 : 1,
            }}
            onPressIn={() =>
              Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light)
            }
            onPressOut={() => handlePress(x)}
            disabled={!isTop}
          >
            <Image
              source={
                isTop
                  ? imageSet[x.img]
                  : require("../assets/cardImgs/backOG.webp")
              }
              style={styles.image}
              resizeMode="stretch"
            />
            {showLabels && isTop && (
              <View style={styles.labelWrap}>
                <Text
                  style={{
                    backgroundColor: "rgba(255, 217, 0, 1)",
                    width: "100%",
                    color: "black",
                    textAlign: "center",
                    fontSize: vw * 0.03,
                    fontWeight: "500",
                    paddingVertical: 1,
                  }}
                  allowFontScaling={false}
                >
                  {x.title[lang]}
                </Text>
              </View>
            )}
          </Pressable>
        );
      })}
    </View>
  );
};

export default FourStack;

const styles = StyleSheet.create({
  imageBox: {
    aspectRatio: "230/360",
    position: "absolute",
    borderRadius: 3,
    overflow: "hidden",
    backgroundColor: "rgba(188, 26, 8, 1)",
  },
  image: {
    width: "100%",
    height: "100%",
  },
  labelWrap: {
    position: "absolute",
    right: 0,
    left: 0,
    bottom: 0,
    margin: 1,
    justifyContent: "center",
    alignItems: "center",
  },
});
</file>

