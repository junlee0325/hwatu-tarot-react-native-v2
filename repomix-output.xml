import { useAudio } from "@/context/AudioContext";
import { useLanguage } from "@/context/LanguageContext";
import { useMute } from "@/context/MuteContext";
import Entypo from "@expo/vector-icons/Entypo";
import Feather from "@expo/vector-icons/Feather";
import MaterialCommunityIcons from "@expo/vector-icons/MaterialCommunityIcons";
import MaterialIcons from "@expo/vector-icons/MaterialIcons";
import { useFonts } from "expo-font";
import * as Haptics from "expo-haptics";
import { useEffect, useRef, useState } from "react";
import {
  Animated,
  Dimensions,
  Image,
  Pressable,
  StyleSheet,
  Text,
  View,
} from "react-native";

interface Card {
  month: string;
  rank: string;
  id: string;
  img: string;
  rotation: number;
  title: { en: string; ko: string };
  meaning: { en: string; ko: string };
}

interface Prop {
  handleDraw: () => void;
  setVisible: (value: boolean) => void;
  remaining: Card[];
  handleReset: () => void;
  first: Card | null;
  showLabels: Boolean;
  setShowLabels: (value: boolean) => void;
  boxFour: Card[];
  setOpenResults: (value: boolean) => void;
  setOpenInfo: (value: boolean) => void;
  setResetOpen: (value: boolean) => void;
}

const audio = { en: "Audio", ko: "음향" };
const helper = { en: "Helper", ko: "도우미" };
const retry = { en: "Restart", ko: "재시작" };
const cycle = { en: "Cycle Deck", ko: "순환" };
const result = { en: "Open Result", ko: "결과 열기" };
const count = { en: "In Deck", ko: "남은 패" };

const Controls = ({
  handleDraw,
  setVisible,
  remaining,
  handleReset,
  first,
  showLabels,
  setShowLabels,
  boxFour,
  setOpenResults,
  setOpenInfo,
  setResetOpen,
}: Prop) => {
  const { lang } = useLanguage();
  const { mute, setMute } = useMute();
  const { playClick } = useAudio();

  const [fontsLoaded] = useFonts({
    "GowunDodum-Regular": require("../assets/fonts/GowunDodum-Regular.ttf"),
    "Gugi-Regular": require("../assets/fonts/Gugi-Regular.ttf"),
  });

  const { width: vw } = Dimensions.get("window");

  const [showCycle, setShowCycle] = useState(false);
  // const [opacity, setOpacity] = useState(1);

  // useEffect(() => {
  //   if (remaining.length === 0) return;
  //   Animated.timing(translateY, {
  //     toValue: 0,
  //     duration: 1,
  //     useNativeDriver: true,
  //   }).start();
  //   setOpacity(1);
  // }, [remaining]);

  useEffect(() => {
    if (remaining.length === 0) return;
    translateY.setValue(0);
    animatedOpacity.setValue(1);
  }, [remaining]);

  // const translateY = useRef(new Animated.Value(0)).current;

  // const handlePressIn = () => {
  //   if (remaining.length === 0) return;
  //   if (first !== null) return;

  //   Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);

  //   translateY.setValue(0);
  //   setOpacity(1);

  //   Animated.timing(translateY, {
  //     toValue: -20,
  //     duration: 200,
  //     useNativeDriver: true,
  //   }).start();
  // };

  // const handlePressOut = () => {
  //   setShowCycle(true);

  //   Animated.timing(translateY, {
  //     toValue: -120,
  //     duration: 100,
  //     useNativeDriver: true,
  //   }).start(() => {
  //     setOpacity(0);
  //     handleDraw();
  //     Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Heavy);
  //     setTimeout(() => playClick(), 100);
  //   });
  // };

  const translateY = useRef(new Animated.Value(0)).current;
  const animatedOpacity = useRef(new Animated.Value(1)).current;

  const handlePressIn = () => {
    if (remaining.length === 0) return;
    if (first !== null) return;

    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);

    translateY.setValue(0);
    animatedOpacity.setValue(1);

    Animated.timing(translateY, {
      toValue: -20,
      duration: 100,
      useNativeDriver: true, // ✅
    }).start();
  };

  const handlePressOut = () => {
    setShowCycle(true);

    Animated.timing(translateY, {
      toValue: -100,
      duration: 50,
      useNativeDriver: true, // ✅
    }).start(() => {
      Animated.timing(animatedOpacity, {
        toValue: 0,
        duration: 0,
        useNativeDriver: true, // ✅
      }).start();
      handleDraw();
      Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Heavy);
      setTimeout(() => playClick(), 50);
    });
  };

  const [cycleBorder, setCycleBorder] = useState(false);
  const [sound, setSound] = useState(true);
  const [labels, setLabels] = useState(true);
  const [restart, setRestart] = useState(true);
  const [touch, setTouch] = useState(true);

  return (
    <View style={styles.bottomBar}>
      {/* Left side: Labels + Card Count */}
      <View
        style={{
          flex: 2,
          flexDirection: "row",
          justifyContent: "center",
          alignItems: "center",
          height: 70,
          paddingVertical: 5,
        }}
      >
        <Pressable
          style={{ width: "50%" }}
          onPressIn={() => {
            Haptics.selectionAsync();
            setLabels(false);
          }}
          onPressOut={() => {
            setLabels(true);
            setShowLabels(!showLabels);
          }}
        >
          <View style={styles.btnCol}>
            <View style={styles.btnIconWrap}>
              <MaterialCommunityIcons
                name={showLabels ? "label-outline" : "label-off-outline"}
                size={vw * 0.08}
                color={labels ? "white" : "rgba(255,255,255,0.5)"}
                allowFontScaling={false}
              />
            </View>
            <Text
              style={{
                color: labels ? "white" : "rgba(255,255,255,0.5)",
                fontSize: vw * 0.035,
                fontFamily: "GowunDodum-Regular",
                height: "40%",
                width: "100%",
                textAlign: "center",
              }}
              allowFontScaling={false}
            >
              {helper[lang]}
            </Text>
          </View>
        </Pressable>

        {/* Card count */}
        <View style={{ ...styles.btnCol, width: "50%" }}>
          <Text
            style={{
              color: "white",
              fontSize: vw * 0.06,
              fontFamily: "Gugi-Regular",
              height: "60%",
              textAlignVertical: "center",
              width: "100%",
              textAlign: "center",
            }}
            allowFontScaling={false}
          >
            {remaining.length}
          </Text>
          <Text
            style={{
              color: "white",
              fontSize: vw * 0.035,
              fontFamily: "GowunDodum-Regular",
              height: "40%",
              width: "100%",
              textAlign: "center",
            }}
            allowFontScaling={false}
          >
            {count[lang]}
          </Text>
        </View>
      </View>

      {/* Center: Draw deck */}
      <View
        style={{
          flex: 1,
          justifyContent: "center",
          alignItems: "center",
          borderRadius: 10,
          overflow: "visible",
          aspectRatio: 230 / 360,
          // boxShadow: "inset 1px 1px 2px 1px black",
          borderWidth: 1,
          borderLeftWidth: 2,
          borderTopWidth: 2,
          backgroundColor: "rgba(122, 122, 122, 0.25)",
        }}
      >
        {remaining.length !== 0 && (
          <Pressable
            style={styles.drawButton}
            onPressIn={() => {
              handlePressIn();
              setTouch(false);
            }}
            onPressOut={() => {
              handlePressOut();
              setTouch(true);
            }}
          >
            <MaterialIcons
              name="touch-app"
              size={36}
              color="rgba(255, 255, 255, 0.75)"
              style={{ padding: 4, zIndex: 50, opacity: touch ? 1 : 0.5 }}
              allowFontScaling={false}
            />
            {remaining.slice(-3).map((x, i) => (
              <Animated.View
                key={i}
                style={{
                  ...styles.imageBox,
                  width: vw * 0.15,
                  left: "50%",
                  top: "50%",
                  transform: [
                    { translateX: -(vw * 0.15) / 2 },
                    { translateY: -(vw * 0.15 * (360 / 230)) / 2 },
                    ...(x === remaining[remaining.length - 1]
                      ? [{ translateY }]
                      : []),
                    // { rotate: `${x.rotation * 1.5}deg` },
                  ],
                  // opacity: x === remaining[remaining.length - 1] ? opacity : 1,
                  // On the top card in remaining.slice(-5).map:
                  opacity:
                    x === remaining[remaining.length - 1]
                      ? animatedOpacity
                      : new Animated.Value(1),
                }}
              >
                <Image
                  source={require("../assets/cardImgs/backOG.webp")}
                  style={styles.image}
                  resizeMode="stretch"
                />
              </Animated.View>
            ))}
          </Pressable>
        )}

        {remaining.length === 0 && showCycle && (
          <Pressable
            onPressIn={() => {
              Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
              setCycleBorder(true);
            }}
            onPressOut={() => {
              Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
              setCycleBorder(false);
              if (boxFour.length === 12) {
                setOpenResults(true);
              } else {
                handleDraw();
                playClick();
              }
            }}
            style={{
              justifyContent: "center",
              alignItems: "center",
              borderRadius: "10%",
              overflow: "hidden",
              width: vw * 0.15,
              aspectRatio: 230 / 360,
              borderStyle: "dashed",
            }}
          >
            <Text
              style={{
                color: !cycleBorder
                  ? "rgba(255, 217, 0, 1)"
                  : "rgba(255, 255, 255, 0.5)",
                fontWeight: "500",
                fontSize: lang === "en" ? vw * 0.04 : vw * 0.05,
                textAlign: "center",
                fontFamily: "Gugi-Regular",
              }}
              allowFontScaling={false}
            >
              {boxFour.length === 12 ? result[lang] : cycle[lang]}
            </Text>
          </Pressable>
        )}
      </View>

      {/* Right side: Mute + Restart */}
      <View
        style={{
          flex: 2,
          flexDirection: "row",
          justifyContent: "center",
          alignItems: "center",
          height: 70,
          paddingVertical: 5,
        }}
      >
        <Pressable
          style={{ width: "50%" }}
          onPressIn={() => {
            Haptics.selectionAsync();
            setSound(false);
          }}
          onPressOut={() => {
            setSound(true);
            setMute(!mute);
          }}
        >
          <View style={styles.btnCol}>
            <View style={styles.btnIconWrap}>
              <Feather
                name={mute ? "volume-x" : "volume-2"}
                size={vw * 0.08}
                color={sound ? "white" : "rgba(255,255,255,0.5)"}
                allowFontScaling={false}
              />
            </View>
            <Text
              style={{
                color: sound ? "white" : "rgba(255,255,255,0.5)",
                fontSize: vw * 0.035,
                fontFamily: "GowunDodum-Regular",
                height: "40%",
                width: "100%",
                textAlign: "center",
              }}
              allowFontScaling={false}
            >
              {audio[lang]}
            </Text>
          </View>
        </Pressable>

        <Pressable
          style={{ width: "50%" }}
          onPressIn={() => {
            Haptics.selectionAsync();
            setRestart(false);
          }}
          onPressOut={() => {
            setRestart(true);
            setResetOpen(true);
          }}
        >
          <View style={styles.btnCol}>
            <View style={styles.btnIconWrap}>
              <Entypo
                name="cycle"
                size={vw * 0.075}
                color={restart ? "white" : "rgba(255,255,255,0.5)"}
                allowFontScaling={false}
              />
            </View>
            <Text
              style={{
                color: restart ? "white" : "rgba(255,255,255,0.5)",
                fontSize: vw * 0.035,
                fontFamily: "GowunDodum-Regular",
                height: "40%",
                width: "100%",
                textAlign: "center",
              }}
              allowFontScaling={false}
            >
              {retry[lang]}
            </Text>
          </View>
        </Pressable>
      </View>
    </View>
  );
};

export default Controls;

const styles = StyleSheet.create({
  bottomBar: {
    height: 100,
    width: "100%",
    flexDirection: "row",
    justifyContent: "space-between",
    alignItems: "center",
    marginVertical: 15,
  },
  drawButton: {
    width: "100%",
    height: "100%",
    flexDirection: "row",
    justifyContent: "center",
    alignItems: "center",
    position: "relative",
  },
  imageBox: {
    height: "auto",
    aspectRatio: "230/360",
    position: "absolute",
    borderWidth: 1,
    borderRadius: 3,
    overflow: "hidden",
    borderColor: "black",
    backgroundColor: "rgba(188, 26, 8, 1)",
    // boxShadow: "2px 2px 2px 0px black",
    borderBottomWidth: 2,
    borderRightWidth: 2,
    borderLeftWidth: 1,
  },
  image: {
    width: "100%",
    height: "100%",
  },
  btnCol: {
    flexDirection: "column",
    justifyContent: "space-between",
    alignItems: "center",
    height: "100%",
    width: "100%",
  },
  btnIconWrap: {
    height: "60%",
    justifyContent: "center",
    alignItems: "center",
    width: "100%",
  },
});
