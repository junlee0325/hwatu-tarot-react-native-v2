                }}
                allowFontScaling={false}
              >
                {close[lang]}
              </Text>
            </Animated.View>
          </Pressable>
        </View>
      </View>
    </Animated.View>
  );
};

export default ResultsOverlay;

const styles = StyleSheet.create({});
