import { useAudio } from "@/context/AudioContext";
import { useLanguage } from "@/context/LanguageContext";
import MaterialIcons from "@expo/vector-icons/MaterialIcons";
import { useFonts } from "expo-font";
import * as Haptics from "expo-haptics";
import { useEffect, useRef, useState } from "react";
import {
  Dimensions,
  Image,
  NativeScrollEvent,
  NativeSyntheticEvent,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";

interface Card {
  month: string;
  rank: string;
  id: string;
  img: string;
  rotation: number;
  title: { en: string; ko: string };
  meaning: { en: string; ko: string };
}

interface Prop {
  remaining: Card[];
  setRemaining: (value: Card[]) => void;
  setVisible: (value: boolean) => void;
  imageSet: Record<string, any>;
  first: Card | null;
  setFirst: (value: Card | null) => void;
  second: Card | null;
  setSecond: (value: Card | null) => void;
  faceUps: Card[];
  setFaceUps: (value: Card[]) => void;
  showLabels: Boolean;
}

const PlayArea = ({
  remaining,
  setRemaining,
  setVisible,
  imageSet,
  first,
  setFirst,
  second,
  setSecond,
  faceUps,
  setFaceUps,
  showLabels,
}: Prop) => {
  const { lang } = useLanguage();
  const { playPlastic } = useAudio();

  const [fontsLoaded] = useFonts({
    "GowunDodum-Regular": require("../assets/fonts/GowunDodum-Regular.ttf"),
    "Gugi-Regular": require("../assets/fonts/Gugi-Regular.ttf"),
  });

  const { width: vw } = Dimensions.get("window");

  const scrollRef = useRef<ScrollView>(null);

  useEffect(() => {
    if (faceUps.length !== 0) {
      scrollRef.current?.scrollToEnd({ animated: true });
    } else {
      scrollRef.current?.scrollTo({ y: 0, animated: true });
    }
  }, [faceUps]);

  const [showPinned, setShowPinned] = useState(false);

  const onScroll = (e: NativeSyntheticEvent<NativeScrollEvent>) => {
    const yOffset = e.nativeEvent.contentOffset.y;
    setShowPinned(yOffset > 25);
  };

  const handlePress = (card: Card) => {
    if (first === null) {
      setFirst(card);
      playPlastic();
      console.log("first card selected");
      return;
    }

    if (card === first) {
      setFirst(null);
      setSecond(null);
      console.log("same card");
      return;
    }

    if (second === null) {
      setSecond(card);
      console.log("initial match");
    }
  };

  const disableCheck = (card: Card) => {
    const firstCard = faceUps[0];
    const lastCard = faceUps[faceUps.length - 1];
    const secondLastCard =
      faceUps.length >= 2 ? faceUps[faceUps.length - 2] : null;

    if (card === firstCard) return false;
    if (card === lastCard) return false;
    if (
      first !== null &&
      first.month === card.month &&
      card === secondLastCard &&
      card.month === lastCard.month &&
      first !== firstCard
    )
      return false;

    return true;
  };

  // const opacityCheck = (card: Card) => {
  //   const firstCard = faceUps[0];
  //   const lastCard = faceUps[faceUps.length - 1];
  //   const secondLastCard =
  //     faceUps.length >= 2 ? faceUps[faceUps.length - 2] : null;

  //   if (card === firstCard) return false;
  //   if (card === lastCard) return false;
  //   if (
  //     first !== null &&
  //     first.month === card.month &&
  //     card === secondLastCard &&
  //     card.month === lastCard.month &&
  //     first !== firstCard
  //   )
  //     return false;
  //   if (
  //     card === secondLastCard &&
  //     card.month === lastCard.month &&
  //     first !== firstCard
  //   )
  //     return false;

  //   return true;
  // };

  const firstIsInFaceUps = first !== null && faceUps.includes(first);
  const firstIsFaceUpsZero = first === faceUps[0];

  const opacityCheck = (card: Card) => {
    const firstCard = faceUps[0];
    const lastCard = faceUps[faceUps.length - 1];
    const secondLastCard =
      faceUps.length >= 2 ? faceUps[faceUps.length - 2] : null;

    if (card === firstCard) return false;
    if (card === lastCard) return false;
    if (
      card === secondLastCard &&
      secondLastCard.month === lastCard.month &&
      (first === null || (firstIsInFaceUps && !firstIsFaceUpsZero))
    )
      return false;

    return true;
  };

  const renderCard = (x: Card, i: number, pinned = false) => {
    const disabled = disableCheck(x);
    const dimmed = opacityCheck(x);
    const selected = first === x;

    return (
      <Pressable
        key={
          pinned ? "pinned" : `${x.id}-${first?.id ?? "none"}-${faceUps.length}`
        }
        style={{
          ...styles.imageBox,
          width: vw * 0.15,
          ...(pinned ? { height: "auto" } : {}),
          borderColor: dimmed
            ? "rgba(0, 0, 0, 0.5)"
            : selected
              ? "rgba(255, 217, 0, 1)"
              : "rgba(0, 0, 0, 0.5)",
          borderWidth: dimmed ? 1 : selected ? 2 : 1,
          borderBottomWidth: 2,
          borderRightWidth: 2,
          transform: [
            { rotate: `${x.rotation * -1}deg` },
            { scale: selected ? 1.15 : 1 },
          ],
          // boxShadow: selected
          //   ? "0px 0px 0px 2px rgba(255, 217, 0, 1)"
          //   : "2px 2px 2px black",
          elevation: 0,
          shadowColor: "#000000",
          zIndex: selected ? 10 : 1,
        }}
        onPressIn={() => Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light)}
        onPressOut={() => handlePress(x)}
        disabled={disabled}
      >
        {/* Disabled overlay */}
        <View
          style={{
            position: "absolute",
            width: "100%",
            height: "100%",
            justifyContent: "center",
            alignItems: "center",
            backgroundColor: dimmed ? "rgba(0, 0, 0, 0.75)" : "transparent",
            zIndex: 4,
            opacity: disabled ? 1 : 0,
          }}
        >
          <MaterialIcons
            name="do-not-touch"
            size={30}
            color="rgba(255, 255, 255, 0.75)"
            style={{ backgroundColor: "rgb(205, 2, 2)", padding: 5 }}
          />
        </View>

        <Image
          source={imageSet[x.img]}
          style={styles.image}
          resizeMode="stretch"
        />

        {showLabels && (
          <View style={styles.labelWrap}>
            <Text
              style={{
                backgroundColor: "rgba(255, 217, 0, 1)",
                width: "100%",
                color: "black",
                textAlign: "center",
                fontSize: vw * 0.03,
                fontWeight: "500",
                paddingVertical: 1,
              }}
              allowFontScaling={false}
            >
              {x.title[lang]}
            </Text>
          </View>
        )}
      </Pressable>
    );
  };

  return (
    <View style={{ width: "100%", height: "30%" }}>
      <ScrollView
        ref={scrollRef}
        style={{ height: "100%" }}
        contentContainerStyle={{
          flexDirection: "row",
          flexWrap: "wrap",
          justifyContent: "center",
          gap: 4,
          paddingVertical: 16,
          paddingHorizontal: 2,
        }}
        showsVerticalScrollIndicator={false}
        onScroll={onScroll}
        scrollEventThrottle={16}
      >
        {faceUps.map((x, i) => renderCard(x, i))}
      </ScrollView>

      {showPinned && faceUps.length > 0 && (
        <View style={styles.pinnedBox}>{renderCard(faceUps[0], 0, true)}</View>
      )}
    </View>
  );
};

export default PlayArea;

const styles = StyleSheet.create({
  imageBox: {
    aspectRatio: "230/360",
    borderRadius: 3,
    overflow: "hidden",
    backgroundColor: "rgba(188, 26, 8, 1)",
  },
  image: {
    width: "100%",
    height: "100%",
  },
  labelWrap: {
    position: "absolute",
    right: 0,
    left: 0,
    bottom: 0,
    margin: 1,
    justifyContent: "center",
    alignItems: "center",
  },
  pinnedBox: {
    position: "absolute",
    top: "2%",
    left: "2%",
    width: 90,
    aspectRatio: 2 / 3,
    borderWidth: 2,
    borderColor: "white",
    borderRadius: 8,
    overflow: "hidden",
    backgroundColor: "rgba(0, 0, 0, 0.75)",
    zIndex: 10,
    justifyContent: "center",
    alignItems: "center",
  },
});
