                alignItems: "center",
                backgroundColor:
                  translateClose === 2 ? "rgb(255, 80, 80)" : "rgb(219, 0, 0)",
                paddingVertical: 0,
                height: "100%",
                width: "100%",
                borderRadius: 10,
                overflow: "hidden",
                // boxShadow: "inset 2px 2px 2px white, 2px 2px 2px 1px black",
                borderWidth: 3,
                borderColor: "rgba(255, 190, 190, 0)",
                transform: [{ translateY: translateClose }],
              }}
            >
